# Copy this file to .env. Keep the JWT in the server environment only.
# Pinata API key with org:files:write; uploads use the PUBLIC network.
PINATA_JWT=
# Metadata blob quotas, shared by hosted staging and simulation on a public server.
# Defaults: 512 MB total, 100 MB awaiting verified launch events. Ledger overhead is additional.
# ELPIDA_METADATA_MAX_BYTES=536870912
# ELPIDA_METADATA_MAX_PENDING_BYTES=104857600
# Optional dedicated gateway: https://YOUR_GATEWAY.mypinata.cloud/ipfs/ (include https://).
# An invalid value is ignored with a warning and the public gateway below is used.
ELPIDA_IPFS_GATEWAY=https://ipfs.io/ipfs/

# Optional X OAuth app; register this exact callback in the X developer console.
ELPIDA_X_CLIENT_ID=
ELPIDA_X_CLIENT_SECRET=
ELPIDA_X_REDIRECT_URI=http://localhost:3000/api/rewards/x/callback

# Hosting: Railway supplies PORT and RAILWAY_PUBLIC_DOMAIN automatically.
# For a custom domain, set its HTTPS origin (no path). Docker binds to 0.0.0.0.
# ELPIDA_PUBLIC_URL=https://your-domain.example
# HOST=0.0.0.0

# Solana: devnet by default. For the mainnet beta (docs/MAINNET_BETA.md) set both:
# ELPIDA_SOLANA_CLUSTER=mainnet
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
#
# Solana RPC rotator (devnet or mainnet): more endpoints, separated by commas. The server uses SOLANA_RPC_URL first,
# then these in order, and moves to the next one when an endpoint fails, rate-limits or runs out of credits (after
# 30 minutes it tries the first one again). Keys stay on the server; logs and the admin page show hosts only.
# SOLANA_RPC_URLS=https://devnet.helius-rpc.com/?api-key=KEY2,https://solana-devnet.g.alchemy.com/v2/KEY3

# Optional Pyth Hermes key (required by Pyth's August 2026 upgrade).
# Kept server-side. Without it, CoinGecko provides timestamped reference prices.
PYTH_API_KEY=
# Additional verified Chainlink-compatible feeds; confirm asset, chain and heartbeat.
# Robinhood launches stay disabled until its USD feed is configured.
ELPIDA_ROBINHOOD_TESTNET_USD_FEED=
ELPIDA_ROBINHOOD_TESTNET_USD_MAX_AGE=3600
# Optional official 6-decimal USDC contract on a network. Never substitute an unlabelled mock.
ELPIDA_BNB_TESTNET_USDC=
ELPIDA_ROBINHOOD_TESTNET_USDC=

# Optional operator-only Circle test funding helper. Never use a live API key.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
ELPIDA_CIRCLE_ADMIN_TOKEN=

# Daily encrypted backups to a private Railway S3-compatible storage bucket.
# Enable only after the bucket, credentials and independently stored encryption key are ready.
ELPIDA_BACKUP_ENABLED=false
ELPIDA_BACKUP_S3_ENDPOINT=
ELPIDA_BACKUP_S3_BUCKET=
ELPIDA_BACKUP_S3_REGION=auto
ELPIDA_BACKUP_S3_ACCESS_KEY_ID=
ELPIDA_BACKUP_S3_SECRET_ACCESS_KEY=
ELPIDA_BACKUP_ENCRYPTION_KEY=
ELPIDA_BACKUP_INTERVAL_HOURS=24
ELPIDA_BACKUP_S3_PATH_STYLE=false
# Optional work directory outside ELPIDA_DATA_DIR. Default: a service-local temporary directory.
# ELPIDA_BACKUP_WORK_DIR=/tmp/elpida-backups
# Reuse this set after Railway redeploys; obtain it from Prepare Circle test wallet.
CIRCLE_WALLET_SET_ID=

# Solana vanity mint addresses (D9). 32-byte key as 64 hex characters or base64; keys ending in the
# suffix are ground in the background and stored encrypted with it. Unset: random mint addresses.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ELPIDA_VANITY_KEY=
# ELPIDA_VANITY_SUFFIX=hope
# ELPIDA_VANITY_TARGET=3
# ELPIDA_VANITY_WORKERS=1

# Explorer source verification (scripts/v2-explorer-verify.mjs): a free key from etherscan.io, one key for every chain.
ETHERSCAN_API_KEY=
