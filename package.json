{
  "name": "elpida-v1",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env apps/api/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:gate": "node scripts/test-gate.mjs",
    "test:gate:strict": "node scripts/test-gate.mjs --strict",
    "test:coverage": "node scripts/test-gate.mjs tests --coverage",
    "verify:checklist": "node scripts/verify-checklist.mjs",
    "refresh:pumpswap-layout": "node scripts/pumpswap-fixture.mjs",
    "test:claims": "node --test tests/claims.test.mjs",
    "rehearse:holders": "node scripts/holder-rehearsal.mjs",
    "test:math": "node --test tests/economics.test.mjs",
    "test:evm": "node --test tests/evm.test.mjs tests/locked-pool.test.mjs tests/curve-pairs.test.mjs tests/beta-curve.test.mjs tests/post-migration-fees.test.mjs",
    "compile": "node scripts/compile.mjs",
    "circle:setup": "node scripts/circle-register-entity.mjs",
    "dev": "node --env-file-if-exists=.env apps/api/server.mjs",
    "test:ui": "node --test tests/api.test.mjs",
    "test:solana": "node --test tests/solana.test.mjs",
    "solana:deploy": "node scripts/solana-deploy.mjs",
    "solana:partner": "node scripts/solana-partner.mjs",
    "indexer": "node scripts/indexer.mjs",
    "testnet:check": "node scripts/testnet-readiness.mjs",
    "test:base-fork": "node scripts/base-fork-lifecycle.mjs",
    "test:chain-fork": "node scripts/chain-fork-lifecycle.mjs",
    "test:equity-fork": "node scripts/equity-fork-check.mjs",
    "test:equity-lifecycle": "node scripts/equity-lifecycle-fork.mjs",
    "test:equity-sim": "node scripts/equity-ethcall-sim.mjs",
    "test:equity-issuer": "node scripts/equity-issuer-powers-fork.mjs",
    "security:package": "node scripts/security-package.mjs",
    "check:production": "node scripts/check-production.mjs",
    "security:scan": "node scripts/secret-scan.mjs",
    "test:operations": "node --test tests/operations-monitoring.test.mjs tests/storage-operations.test.mjs tests/backup-retention.test.mjs",
    "backup:key": "node scripts/backup-key.mjs",
    "backup:offsite": "node --env-file-if-exists=.env scripts/offsite-backup.mjs",
    "test:indexer": "node --test tests/indexer.test.mjs tests/public-indexer.test.mjs tests/solana-indexer.test.mjs",
    "test:dex": "node --test --test-concurrency=1 tests/dex-migration.test.mjs tests/dex-runtime.test.mjs",
    "test:solana-host": "cargo test --release --manifest-path contracts/solana/host-tests/Cargo.toml",
    "compile:v4": "node scripts/compile-v4.mjs",
    "test:v4": "node --test tests/v4-locked-launch.test.mjs"
  },
  "overrides": {
    "solc": {
      "tmp": "0.2.7"
    },
    "jayson": {
      "uuid": "11.1.1",
      "stream-json": "3.7.0"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1151.0",
    "@circle-fin/developer-controlled-wallets": "10.8.1",
    "@openzeppelin/contracts": "^5.4.0",
    "@solana/web3.js": "1.98.4",
    "@uniswap/v3-core": "^1.0.1",
    "@uniswap/v3-periphery": "^1.4.4",
    "@uniswap/v4-core": "1.0.2",
    "@uniswap/v4-periphery": "1.0.3",
    "ethers": "6.17.0",
    "hardhat": "3.19.0",
    "lightweight-charts": "5.2.1",
    "solc": "0.8.24",
    "solc-0.8.26": "npm:solc@0.8.26"
  }
}
