# Elpida's own Cloudflare Tunnel on a shared server (setup-shared.sh), so another app's cloudflared service is never
# replaced. The token is in /etc/elpida/tunnel.env (root only, 0600) as TUNNEL_TOKEN=..., which cloudflared reads.
[Unit]
Description=Cloudflare Tunnel for Elpida
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/elpida/tunnel.env
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run
Restart=always
RestartSec=5
DynamicUser=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
